{
  "name": "vendingco/dashboard",
  "description": "Vending Machine Dashboard - full stack PHP/MySQL application",
  "type": "project",
  "require": {
    "php": ">=8.1",
    "aws/aws-sdk-php": "^3.0",
    "vlucas/phpdotenv": "^5.0"
  },
  "autoload": {
    "psr-4": {
      "VendingCo\\": "src/"
    }
  },
  "config": {
    "optimize-autoloader": true,
    "sort-packages": true
  }
}
